{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": {
    "name": "my-ingress",
    "namespace": "default"
  },
  "spec": {
    "ingressClassName": "nginx",
    "rules": [
      {
        "host": "example.com",
        "http": {
          "paths": [
            {
              "backend": {
                "service": {
                  "name": "my-service",
                  "port": {
                    "number": 80
                  }
                }
              },
              "path": "/",
              "pathType": "Prefix"
            }
          ]
        }
      }
    ]
  }
}
