{
  "apiVersion": "apps/v1",
  "kind": "DaemonSet",
  "metadata": {
    "annotations": {
      "deprecated.daemonset.template.generation": "1"
    },
    "labels": {
      "app": "fluentd"
    },
    "name": "fluentd-daemonset",
    "namespace": "monitoring"
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app": "fluentd"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "fluentd"
        }
      },
      "spec": {
        "containers": [
          {
            "image": "fluentd:v1.16",
            "name": "fluentd"
          }
        ]
      }
    }
  }
}
